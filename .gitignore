# --------------------------------------------------------------------------
# Submission rule 4: the original binary must never enter the repository.
# tools/compliance_check.py fails the build if any of these appear anyway.
# --------------------------------------------------------------------------
GPower*.exe
GPower*.zip
GPower*.dmg
GPower*.msi
gpower*.exe
*.exe
*.dll
*.dylib
*.so
*.msi
*.dmg
*.pkg

# Decompiler / disassembler artefacts
*.asm
*.lst
*.dis
*.decompiled
*.idb
*.i64
*.ida
*.bpl
*.dcu
*.obj

# --------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
.venv/
venv/
env/
.Python

# --------------------------------------------------------------------------
# Tooling caches
# --------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --------------------------------------------------------------------------
# Editors / OS
# --------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------------------------------------
# Secrets
# --------------------------------------------------------------------------
.env
.env.*
!.env.example

# --------------------------------------------------------------------------
# Probe worksheets ARE tracked on purpose: probes/probe_worksheet.csv carries
# the predictions, and probes/REA-RESULTS.md carries the verdicts.  Both are
# evidence.  Only scratch files are ignored.
# --------------------------------------------------------------------------
probes/scratch/
probes/*.bak
